{
  config,
  lib,
  ...
}:
with lib; let
  outerCfg = config;
  enabled = filterAttrs (_: cfg: cfg.enable) outerCfg.myOpt.camofox-compose;
  mkHttpUrl = host: port: let
    bracketedHost =
      if hasPrefix "[" host
      then host
      else if hasInfix ":" host
      then "[${host}]"
      else host;
  in "http://${bracketedHost}:${toString port}";
  toSliceUnit = p:
    if p == null
    then null
    else if hasSuffix ".slice" p
    then p
    else "${p}.slice";
  resolveNetns = nsName: let
    entry = outerCfg.myOpt.netns.${nsName} or null;
  in
    if entry != null
    then {
      inherit (entry) path resolvConf unit;
    }
    else {
      path = "/run/netns/${nsName}";
      resolvConf = "/etc/netns/${nsName}/resolv.conf";
      unit = "${nsName}.service";
    };
in {
  options.myOpt.camofox-compose = mkOption {
    default = {};
    type = types.attrsOf (types.submodule ({name, ...} @ innerArgs: let
      cfg = innerArgs.config;
    in {
      options = {
        enable = mkOption {
          type = types.bool;
          default = true;
        };
        serviceName = mkOption {
          type = types.singleLineStr;
          default = "${name}-camofox";
        };
        image = mkOption {
          type = types.singleLineStr;
          example = "ghcr.io/jo-inc/camofox-browser:1.18.1";
        };
        host = mkOption {
          type = types.singleLineStr;
          default = "::1";
        };
        port = mkOption {
          type = types.port;
        };
        url = mkOption {
          type = types.singleLineStr;
          default = mkHttpUrl cfg.host cfg.port;
        };
        telemetry = mkOption {
          type = types.bool;
          default = true;
        };
        # Name of the sops secret whose content is passed as EnvironmentFile.
        envFile-key = mkOption {
          type = types.nullOr types.singleLineStr;
          default = null;
        };
        cgroup-parent = mkOption {
          type = types.nullOr types.singleLineStr;
          default = null;
        };
        networkNamespace = mkOption {
          type = types.nullOr types.singleLineStr;
          default = null;
        };
        environment = mkOption {
          type = types.attrsOf types.str;
          default = {};
        };
      };
    }));
  };

  config = mkIf (enabled != {}) {
    # Only declares the secret; the sops file stays with the caller
    # (sops.secrets.<key>.sopsFile or sops.defaultSopsFile).
    sops.secrets = mkMerge (mapAttrsToList (_: cfg:
        optionalAttrs (cfg.envFile-key != null) {
          ${cfg.envFile-key} = {};
        })
      enabled);

    virtualisation.oci-containers.backend = "podman";
    virtualisation.oci-containers.containers = mkMerge (mapAttrsToList (_: cfg: let
        sliceUnit = toSliceUnit cfg.cgroup-parent;
        ns =
          if cfg.networkNamespace != null
          then resolveNetns cfg.networkNamespace
          else null;
      in {
        ${cfg.serviceName} = {
          inherit (cfg) serviceName image;
          autoStart = false;
          networks = optional (ns != null) "ns:${ns.path}";
          volumes = optional (ns != null) "${ns.resolvConf}:/etc/resolv.conf:ro";
          environment =
            {
              CAMOFOX_BIND_HOST = cfg.host;
              CAMOFOX_PORT = toString cfg.port;
              CAMOFOX_CRASH_REPORT_ENABLED = boolToString cfg.telemetry;
            }
            // cfg.environment;
          environmentFiles = optionals (cfg.envFile-key != null) [outerCfg.sops.secrets.${cfg.envFile-key}.path];
          extraOptions =
            [
              "--shm-size=2g" # Firefox needs real shared memory; the default 64MB is not enough
              "--read-only"
              "--tmpfs=/tmp:rw,nosuid,nodev,size=512m"
              "--tmpfs=/run:rw,noexec,nosuid,nodev,size=32m"
              "--tmpfs=/root/.camofox:rw,noexec,nosuid,nodev,size=256m"
              "--cap-drop=ALL"
              "--security-opt=no-new-privileges"
              "--pids-limit=512"
            ]
            ++ optional (sliceUnit != null) "--cgroup-parent=${sliceUnit}";
        };
      })
      enabled);

    # The unit generated by virtualisation.oci-containers is only a thin
    # `podman run` wrapper: hardening belongs to the container (--read-only,
    # --cap-drop=ALL, --security-opt=no-new-privileges, tmpfs mounts and
    # --cgroup-parent below), not to the wrapper that spawns it. Keep only
    # the ordering dependency on the network namespace unit.
    systemd.services = mkMerge (mapAttrsToList (_: cfg: let
        ns =
          if cfg.networkNamespace != null
          then resolveNetns cfg.networkNamespace
          else null;
      in {
        ${cfg.serviceName} = mkIf (ns != null) {
          bindsTo = [ns.unit];
          after = [ns.unit];
        };
      })
      enabled);
  };
}
